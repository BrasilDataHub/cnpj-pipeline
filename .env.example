# =============================================================================
# Variáveis de Ambiente - ETL CNPJ da Receita Federal
# =============================================================================
# Copie este arquivo para .env e ajuste os valores conforme necessário.
#
# Uso:
#   cp .env.example .env
#   # Edite o arquivo .env com suas configurações
#   docker compose up -d postgres
#   docker compose run --rm etl complete --month 07/2026 --parallel
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
# Credenciais do banco de dados
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sua_senha_segura_aqui
POSTGRES_DBNAME=dados_cnpj

# Host do PostgreSQL (use 'postgres' para Docker, 'localhost' para execução local)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Porta exposta no host (para acesso externo ao PostgreSQL)
FORWARD_DB_PORT=5432

# -----------------------------------------------------------------------------
# Imagem customizada (ghcr.io/brasildatahub/postgres:17 — repositório infra/)
# -----------------------------------------------------------------------------
# O tuning vem das envs PG_* e os DEFAULTS já são o cenário atual (host
# compartilhado, ~4 GB p/ o Postgres) — normalmente NADA a definir aqui.
# Em máquina com mais folga, sobrescreva (tabela completa e cenários por
# máquina: infra/postgres/README.md). Exemplos:
# PG_SHARED_BUFFERS=2GB
# PG_EFFECTIVE_CACHE_SIZE=4GB
# PG_WORK_MEM=32MB
# PG_MAINTENANCE_WORK_MEM=512MB
# PG_MAX_WAL_SIZE=4GB
# PG_RANDOM_PAGE_COST=1.5
# PG_SHM_SIZE=1gb
# PG_MEMORY_LIMIT=8G

# Senha do role de leitura do website (criado no primeiro initdb; opcional
# em ambiente de ETL local — sem ela o role nasce NOLOGIN)
# DADOS_READ_PASSWORD=

# -----------------------------------------------------------------------------
# Diretórios (opcional - valores padrão funcionam com Docker)
# -----------------------------------------------------------------------------
# Caminho para salvar arquivos baixados
# DOWNLOAD_PATH=/app/data/downloads

# Caminho dos CSVs do IBGE
# IBGE_CSV_DIR=/app/data/locations

# -----------------------------------------------------------------------------
# WebDAV (Nextcloud) da Receita Federal
# -----------------------------------------------------------------------------
# URL base WebDAV para os dados CNPJ. Altere se o token de acesso mudar.
# RFB_WEBDAV_URL=https://arquivos.receitafederal.gov.br/public.php/dav/files/gn672Ad4CF8N6TK/Dados/Cadastros/CNPJ/

# -----------------------------------------------------------------------------
# Observabilidade: estado/retomada, dashboard e webhooks (todas opcionais)
# Guia: docs/observabilidade.md
# -----------------------------------------------------------------------------
# Onde fica o estado de execução (checkpoint da retomada). Em Docker, precisa
# ser um volume — sem isso o progresso morre junto com o container.
# PIPELINE_STATE_DIR=/app/data/state

# Notificações HTTP por etapa. Em container, a URL precisa ser alcançável de
# DENTRO dele (host.docker.internal para um servidor no host).
# PIPELINE_WEBHOOK_URL=https://n8n.exemplo.com/webhook/cnpj

# Dashboard web (só sobe com --serve). A senha protege a página e o
# /state.json; se vazia, o pipeline gera uma e mostra no log.
# PIPELINE_PORT=3010
# PIPELINE_DASHBOARD_PASSWORD=
# PIPELINE_DASHBOARD_USER=pipeline
# PIPELINE_REFRESH_SECONDS=6

# Tentativas por etapa antes de exigir intervenção (0 = ilimitado)
# PIPELINE_MAX_ATTEMPTS=3

# Onde lotes de COPY que falharam definitivamente são preservados (CSV + .meta)
# PIPELINE_DEAD_LETTER_DIR=/app/data/logs/dead_letter

# Porta publicada no host para o dashboard (só docker-compose)
# FORWARD_DASHBOARD_PORT=3010

# -----------------------------------------------------------------------------
# Criação de índices (o banco de carga não tem leitores — velocidade máxima)
# Pico de memória ≈ INDEX_MAX_WORKERS × INDEX_MAINTENANCE_WORK_MEM;
# em hosts com 8–16 GB de RAM, reduza um dos dois.
# -----------------------------------------------------------------------------
# INDEX_MAX_WORKERS=4
# INDEX_MAINTENANCE_WORK_MEM=2GB
