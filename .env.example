# Configurações do PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret
POSTGRES_DBNAME=Dados_RFB

# Porta para expor o PostgreSQL (opcional, usado apenas no docker-compose)
FORWARD_DB_PORT=5432

# Diretórios para armazenamento dos arquivos
DOWNLOAD_PATH=data/downloads
# Diretório com os CSVs de regiões/estados/cidades do IBGE (regioes.csv, estados.csv, cidades.csv)
IBGE_CSV_DIR=data/locations
