# =============================================================================
# Variáveis de Ambiente - ETL CNPJ da Receita Federal
# =============================================================================
# Copie este arquivo para .env e ajuste os valores conforme necessário.
#
# Uso:
#   cp .env.example .env
#   # Edite o arquivo .env com suas configurações
#   docker compose up -d postgres
#   docker compose run --rm etl complete --month 01/2026 --parallel
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
# Credenciais do banco de dados
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sua_senha_segura_aqui
POSTGRES_DBNAME=dados_cnpj

# Host do PostgreSQL (use 'postgres' para Docker, 'localhost' para execução local)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Porta exposta no host (para acesso externo ao PostgreSQL)
FORWARD_DB_PORT=5432

# -----------------------------------------------------------------------------
# Diretórios (opcional - valores padrão funcionam com Docker)
# -----------------------------------------------------------------------------
# Caminho para salvar arquivos baixados
# DOWNLOAD_PATH=/app/data/downloads

# Caminho dos CSVs do IBGE
# IBGE_CSV_DIR=/app/data/locations

# -----------------------------------------------------------------------------
# WebDAV (Nextcloud) da Receita Federal
# -----------------------------------------------------------------------------
# URL base WebDAV para os dados CNPJ. Altere se o token de acesso mudar.
# RFB_WEBDAV_URL=https://arquivos.receitafederal.gov.br/public.php/dav/files/gn672Ad4CF8N6TK/Dados/Cadastros/CNPJ/
